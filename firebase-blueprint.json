{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings, currency preferences, and daily alert thresholds",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "monthlyIncome": { "type": "number" },
        "monthlySavingsTarget": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger transactions including income, expense, and loan EMIs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["expense", "income", "loan_emi"] },
        "categoryId": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "merchant": { "type": "string" },
        "notes": { "type": "string" },
        "rawDescription": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date", "amount", "type", "categoryId", "paymentMethod"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly spending budget allocations per category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "monthlyLimit": { "type": "number" },
        "warningThreshold": { "type": "number" }
      },
      "required": ["id", "categoryId", "monthlyLimit"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Financial savings goals with target amount and deadlines",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "targetAmount", "currentAmount"]
    },
    "WhatsAppMessage": {
      "title": "WhatsAppMessage",
      "description": "WhatsApp webhook incoming messages and idempotency records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "messageId": { "type": "string" },
        "from": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["received", "processing", "processed", "failed", "duplicate"] },
        "userId": { "type": "string" },
        "transactionId": { "type": "string" },
        "processedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "messageId", "from", "status"]
    },
    "WhatsAppUser": {
      "title": "WhatsAppUser",
      "description": "Phone number to userId binding for webhook routing",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "linkedAt": { "type": "string" }
      },
      "required": ["phone", "userId"]
    },
    "FriendDebt": {
      "title": "FriendDebt",
      "description": "Peer-to-peer friend lending and borrowing tracking (who owes whom)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "friendName": { "type": "string" },
        "friendPhone": { "type": "string" },
        "type": { "type": "string", "enum": ["lent", "borrowed"] },
        "amount": { "type": "number" },
        "settledAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "partially_settled", "settled"] },
        "date": { "type": "string" },
        "dueDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "friendName", "type", "amount", "status", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User ledger transactions"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": "Budget",
      "description": "User monthly category budgets"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "User savings goals"
    },
    "/users/{userId}/friend_debts/{debtId}": {
      "schema": "FriendDebt",
      "description": "User peer-to-peer friend loans, lent money, and borrowed debts"
    },
    "/whatsapp_messages/{messageId}": {
      "schema": "WhatsAppMessage",
      "description": "Idempotency store for WhatsApp Business Cloud API incoming messages"
    },
    "/whatsapp_users/{phone}": {
      "schema": "WhatsAppUser",
      "description": "Phone number to userId directory"
    }
  }
}
